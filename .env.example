# Clé API Resend (service d'envoi de mails, offre gratuite) : https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# L'adresse qui reçoit les alertes (avec l'expéditeur de test de Resend,
# ce doit être l'adresse avec laquelle tu as créé ton compte Resend)
EMAIL_DESTINATAIRE=ton.adresse@exemple.com

# Facultatif : expéditeur (par défaut l'adresse de test de Resend)
# EMAIL_EXPEDITEUR=Robot Alertes <onboarding@resend.dev>

# Un mot de passe long et aléatoire de ton choix, qui protège la route /api/check
CRON_SECRET=change-moi-par-une-longue-chaine-aleatoire
